{
  "name": "@deepseek-ai/dsh-desktop-tauri",
  "productName": "ClawMaster",
  "description": "ClawMaster Tauri shell powered by the DSH runtime",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:rpa-native": "node scripts/prepare-rpa-native.mjs --smoke",
    "build:harness": "node --import tsx/esm scripts/build-harness.ts",
    "test:branding": "node --import tsx/esm --test scripts/build-harness.test.mjs",
    "bundle:source": "node scripts/bundle-harness-source.mjs",
    "prepare:dist": "node scripts/prepare-dist.mjs",
    "dev": "tauri dev",
    "dev:local": "cross-env DSH_DESKTOP_LAUNCH=local tauri dev",
    "test:update-manifest": "node --test scripts/generate-updater-manifest.test.mjs scripts/release-channel.test.mjs scripts/release-workflow.test.mjs",
    "test:bundle": "node --test scripts/bundle-harness-source.test.mjs scripts/desktop-defaults.test.mjs scripts/build-provenance.test.mjs scripts/build-inventory.test.mjs scripts/webview-security.test.mjs scripts/generate-icons.test.mjs scripts/test-compatibility.test.mjs scripts/prepare-rpa-native.test.mjs",
    "test:overlay": "node --test overlay/desktop-notify/index.test.mjs",
    "test:startup": "node --test scripts/harness-startup.test.mjs",
    "test:compat": "node scripts/test-compatibility.mjs",
    "build": "tauri build",
    "build:win": "tauri build --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "cross-env": "^7.0.3"
  }
}
