{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local packaged shell controls; the Host content WebView receives no native commands.",
  "webviews": ["splash", "main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "allow-set-close-action",
    "allow-dismiss-close-prompt",
    "allow-restart-app"
  ]
}
