{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {},
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true
  },
  "include": ["src/**/*.ts", "seam/**/*.ts"],
  "exclude": ["seam/**/*.test.ts"]
}
