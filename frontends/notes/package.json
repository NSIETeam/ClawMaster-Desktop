{
  "name": "@clawmaster/dsh-notes",
  "version": "0.1.0",
  "description": "Built-in Obsidian-style notes vault for ClawMaster",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node --import tsx/esm --test tests/*.test.mjs",
    "test:client": "vitest run --config tests/vitest.client.config.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mdxeditor/editor": "4.2.5",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
